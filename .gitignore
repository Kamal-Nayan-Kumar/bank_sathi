# venv / deps
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/

# Secrets. .env.example is the template; .env is never committed.
.env
.env.*
!.env.example

# Generated data. The policy markdown under data/policies/ is hand-written
# source and IS committed; everything else is reproducible from the seed.
data/cards.json
data/profiles.jsonl
data/ground_truth.json
data/*.sqlite3
data/vectors/

# Evaluation output
evaluation/results.json
evaluation/results.md
evaluation/runs/

# Frontend
frontend/node_modules/
frontend/dist/
frontend/.vite/
frontend/.env.local
frontend/.env*.local
npm-debug.log*

# Editor / OS
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
.idea/
.vscode/*
!.vscode/settings.json
*.swp
*.swo
*~

# Logs
*.log
logs/
