# Bank Sathi - environment
#
# Copy to `.env` and fill in the blanks. Everything else has a working local
# default, so an empty file still boots the app on SQLite with the deterministic
# fallback path.
#
# Only credentials live here. Tunables are constants in
# backend/app/thresholds.py, where the rule engine reads them.

# --- LLM: Groq primary -----------------------------------------------------
# https://console.groq.com/keys
# Optional. Without it, the system still answers: intake falls back to a regex
# extractor and explanations fall back to a deterministic template.
GROQ_API_KEY=

# --- LLM: OpenRouter fallback ----------------------------------------------
# Optional. Only used after Groq fails, which on the free tier is common —
# Groq rate-limits hard. Both fields must be set for the fallback to activate.
OPENROUTER_API_KEY=
# The model must be a `:free` endpoint. Check what your key can reach with:
#   curl https://openrouter.ai/api/v1/models | grep '"id".*free'
OPENROUTER_MODEL_EXTRACT=nvidia/nemotron-3-super-120b-a12b:free
OPENROUTER_MODEL_EXPLAIN=nvidia/nemotron-3-super-120b-a12b:free

# --- Neon (PostgreSQL) -----------------------------------------------------
# https://neon.tech -> Connection string. Use the POOLED url for a web service.
# Optional. Without it the app uses a local SQLite file.
DATABASE_URL=

# --- Qdrant (vector store) -------------------------------------------------
# https://qdrant.cloud -> your cluster endpoint and API key.
# Optional. Without it the app uses an in-process store; ingest is re-run on
# every boot, so the corpus is always in sync with the markdown.
QDRANT_URL=
QDRANT_API_KEY=
