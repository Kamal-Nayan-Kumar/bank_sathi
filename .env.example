# =============================================================================
# Bank Sathi - Credit Card Recommendation Engine
# Copy to `.env` and fill in. Every value below is optional for local dev:
# the app falls back to SQLite + an in-process vector store + rule-based
# explanations when cloud keys are absent.
# =============================================================================

# --- App ---------------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO

# --- LLM: Groq (OpenAI-compatible) -------------------------------------------
# https://console.groq.com/keys
GROQ_API_KEY=
# Cheap + fast: profile extraction, follow-ups, intent.
# List what your key can reach with: curl https://api.groq.com/openai/v1/models
GROQ_MODEL_EXTRACT=qwen/qwen3.8-27b
# Stronger: grounded explanation generation.
GROQ_MODEL_EXPLAIN=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# --- Embeddings --------------------------------------------------------------
# Primary: OpenAI embeddings. If no key is set, the app falls back to a
# deterministic local hash embedder so retrieval still works offline.
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-ada-002

# --- Vector DB: Qdrant -------------------------------------------------------
# Qdrant Cloud: https://qdrant.cloud  ->  create a cluster, copy the URL + key.
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=bank_sathi_policies
# Optional: path for Qdrant local (on-disk) mode. Unset => in-memory ephemeral.
QDRANT_LOCAL_PATH=

# --- Postgres: Neon ----------------------------------------------------------
# Neon: https://neon.tech  ->  Connection string (pooled URL is fine).
# Leave DATABASE_URL empty to use a local SQLite file instead.
DATABASE_URL=
# Connection timeout / pool settings (Neon-friendly defaults)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_STATEMENT_TIMEOUT_MS=15000

# --- Data / seeding ----------------------------------------------------------
# Absolute or relative path to the generated card catalogue.
CARDS_JSON_PATH=data/cards.json
# Seed for all synthetic data generation. Change it and the dataset changes.
SYNTHETIC_SEED=20240607
# Where policy markdown is generated from policy.yaml (single source of truth).
POLICY_DOCS_DIR=data/policies

# --- Retrieval ---------------------------------------------------------------
RAG_TOP_K=5
RAG_MIN_SCORE=0.15
RAG_EMBED_DIM=512

# --- Explanation / verifier --------------------------------------------------
MAX_EXPLAIN_RETRIES=2
ENABLE_VERIFIER_LLM_CHECK=false
